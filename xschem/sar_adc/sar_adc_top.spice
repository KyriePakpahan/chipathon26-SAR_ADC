x_nand_done Q7 comp_done done_nand vdd vss async_nand2
x_inv_done vdd done_nand done vss async_inverter
.ends

* 5. Top Circuit: sar_adc_top
.subckt sar_adc_top vin vref start vdd vss done d7 d6 d5 d4 d3 d2 d1 d0
x_sh vin sample_en vhold vdd vss sample_hold
x_cdac vref dac_in[7] dac_in[6] dac_in[5] dac_in[4] dac_in[3] dac_in[2] dac_in[1] dac_in[0] vdac vdd vss cdac_8bit
x_comp vhold vdac rst_latch vdd vss comp_out_p comp_out_n comp_done strongarm_comp
x_sar sample_en rst_latch done d7 d6 d5 d4 d3 d2 d1 d0 dac_in[7] dac_in[6] dac_in[5] dac_in[4] dac_in[3] dac_in[2] dac_in[1] dac_in[0] start comp_out_p comp_out_n vdd comp_done vss async_sar
.ends
