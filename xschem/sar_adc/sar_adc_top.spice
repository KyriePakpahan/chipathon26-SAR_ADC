.subckt async_pulse_settle vdd vss in out
x1 vdd in net1 vss async_inverter
x2 vdd net1 net2 vss async_inverter
x3 vdd net2 net3 vss async_inverter
x4 vdd net3 net4 vss async_inverter
x5 vdd net4 net5 vss async_inverter
x6 vdd net5 net6 vss async_inverter
x7 vdd net6 net7 vss async_inverter
x8 vdd net7 in_delayed_n vss async_inverter
x_nor_pulse in in_delayed_n out vdd vss async_nor2
.ends

.subckt async_sar sample_en rst_latch done dout[7] dout[6] dout[5] dout[4] dout[3] dout[2] dout[1] dout[0] dac_in[7] dac_in[6] dac_in[5] dac_in[4] dac_in[3] dac_in[2] dac_in[1] dac_in[0] start comp_out_p comp_out_n vdd comp_done vss
x_inv_se vdd start sample_en vss async_inverter
x_inv_cd vdd comp_done comp_done_b vss async_inverter
x_sr8 vdd vss Q0 Q1 Q2 Q3 Q4 Q5 Q6 Q7 sr_done vdd comp_done_b sample_en shift_reg_8bit

x_bit_reg_0 vdd vss Q0 comp_done comp_out_p dout[7] sample_en bit_reg
x_bit_reg_1 vdd vss Q1 comp_done comp_out_p dout[6] sample_en bit_reg
