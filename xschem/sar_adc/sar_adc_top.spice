** Complete Monolithic 8-bit Asynchronous SAR ADC Top Netlist (sar_adc_top.spice)

* 1. Sample & Hold Subcircuit
.subckt inv_sh vdd vo vi vss
XM1 vo vi vss vss nfet_03v3 L=0.28u W=1u nf=1
XM2 vo vi vdd vdd pfet_03v3 L=0.28u W=2u nf=1
.ends

.subckt sample_hold vin sample_en vhold vdd vss
x_inv vdd clkb sample_en vss inv_sh
XM1 vhold sample_en vin vss nfet_03v3 L=0.28u W=4.00u nf=2
XM2 vin clkb vhold vdd pfet_03v3 L=0.28u W=8.00u nf=2
XC2 vhold vss cap_mim_2f0fF c_width=15e-6 c_length=10e-6
.ends

* 2. CDAC 8-Bit Subcircuit
.subckt cdac_switch_1b bit_in vref vdd vss bot
XM_inv_p bit_b bit_in vdd vdd pfet_03v3 L=0.28u W=2.0u nf=1
XM_inv_n bit_b bit_in vss vss nfet_03v3 L=0.28u W=1.0u nf=1
XM_vref bot bit_b vref vdd pfet_03v3 L=0.28u W=6.0u nf=2
XM_gnd  bot bit_in vss vss nfet_03v3 L=0.28u W=3.0u nf=2
.ends

.subckt cdac_8bit vref dac_in[7] dac_in[6] dac_in[5] dac_in[4] dac_in[3] dac_in[2] dac_in[1] dac_in[0] vdac vdd vss
XSW0 dac_in[0] vref vdd vss bot0 cdac_switch_1b
XC0 vdac bot0 cap_mim_2f0fF c_width=5e-6 c_length=5e-6
XSW1 dac_in[1] vref vdd vss bot1 cdac_switch_1b
XC1 vdac bot1 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=2
XSW2 dac_in[2] vref vdd vss bot2 cdac_switch_1b
XC2 vdac bot2 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=4
XSW3 dac_in[3] vref vdd vss bot3 cdac_switch_1b
XC3 vdac bot3 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=8
XSW4 dac_in[4] vref vdd vss bot4 cdac_switch_1b
XC4 vdac bot4 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=16
XSW5 dac_in[5] vref vdd vss bot5 cdac_switch_1b
XC5 vdac bot5 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=32
XSW6 dac_in[6] vref vdd vss bot6 cdac_switch_1b
XC6 vdac bot6 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=64
XSW7 dac_in[7] vref vdd vss bot7 cdac_switch_1b
XC7 vdac bot7 cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=128
.ends

* 3. StrongArm Dynamic Comparator Subcircuit
.subckt comp_inv_3v3 vi vo vdd vss
XM1 vo vi vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM2 vo vi vss vss nfet_03v3 L=0.28u W=0.5u nf=1
.ends

.subckt comp_nand_3v3 a b out vdd vss
XM1 out a vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM2 out b vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM3 out a mid vss nfet_03v3 L=0.28u W=1.0u nf=1
XM4 mid b vss vss nfet_03v3 L=0.28u W=1.0u nf=1
.ends

.subckt comp_xor_fast a b out vdd vss
x1 a b nab vdd vss comp_nand_3v3
x2 a nab a_nab vdd vss comp_nand_3v3
x3 b nab b_nab vdd vss comp_nand_3v3
x4 a_nab b_nab out vdd vss comp_nand_3v3
.ends

.subckt strongarm_comp_core vin_p vin_n rst_latch vdd vss out_p out_n
XM_tail tail rst_latch vss vss nfet_03v3 L=0.28u W=4.0u nf=2
XM_in_p dn vin_p tail vss nfet_03v3 L=0.28u W=4.0u nf=2
XM_in_n dp vin_n tail vss nfet_03v3 L=0.28u W=4.0u nf=2
XM_cross_n out_n out_p dn vss nfet_03v3 L=0.28u W=2.0u nf=1
XM_cross_p out_p out_n dp vss nfet_03v3 L=0.28u W=2.0u nf=1
XM_latch_n out_n out_p vdd vdd pfet_03v3 L=0.28u W=2.0u nf=1
XM_latch_p out_p out_n vdd vdd pfet_03v3 L=0.28u W=2.0u nf=1
XM_rst_n out_n rst_latch vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM_rst_p out_p rst_latch vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM_rst_dn dn rst_latch vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM_rst_dp dp rst_latch vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
.ends

.subckt strongarm_comp vin_p vin_n rst_latch vdd vss out_p out_n comp_done
x_core vin_p vin_n rst_latch vdd vss raw_p raw_n strongarm_comp_core
x_inv_p raw_p out_p vdd vss comp_inv_3v3
x_inv_n raw_n out_n vdd vss comp_inv_3v3
x_done_xor out_p out_n comp_done vdd vss comp_xor_fast
.ends

* 4. Asynchronous SAR Logic Subcircuit
.subckt async_inverter vdd input out vss
XM5 out input vdd vdd pfet_03v3 L=0.28u W=0.80u nf=1
XM6 out input vss vss nfet_03v3 L=0.28u W=0.42u nf=1
.ends

.subckt async_nor2 a b out vdd vss
XM1 mid a vdd vdd pfet_03v3 L=0.28u W=0.80u nf=1
XM2 out b mid vdd pfet_03v3 L=0.28u W=0.80u nf=1
XM3 out a vss vss nfet_03v3 L=0.28u W=0.42u nf=1
XM4 out b vss vss nfet_03v3 L=0.28u W=0.42u nf=1
.ends

.subckt async_nand2 a b out vdd vss
XM1 out a vdd vdd pfet_03v3 L=0.28u W=0.80u nf=1
XM2 out b vdd vdd pfet_03v3 L=0.28u W=0.80u nf=1
XM3 out a mid vss nfet_03v3 L=0.28u W=0.42u nf=1
XM4 mid b vss vss nfet_03v3 L=0.28u W=0.42u nf=1
.ends

.subckt dff_cell vdd vss clk d q q_bar rst_n
XM1 clk_n clk vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM2 clk_n clk vss vss nfet_03v3 L=0.28u W=0.50u nf=1
XM3 M clk_n D_int vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM4 D_int clk M vss nfet_03v3 L=0.28u W=0.50u nf=1
XM5 M_bar M vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM6 M_bar M vss vss nfet_03v3 L=0.28u W=0.50u nf=1
XM7 M M_bar vdd vdd pfet_03v3 L=2.0u W=0.42u nf=1
XM8 M M_bar vss vss nfet_03v3 L=2.4u W=0.42u nf=1
XM9 S clk M_bar vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM10 M_bar clk_n S vss nfet_03v3 L=0.28u W=0.50u nf=1
XM11 Q_bar S vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM12 Q_bar rst_n vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM13 Q_bar S net1 vss nfet_03v3 L=0.28u W=0.50u nf=1
XM14 net1 rst_n vss vss nfet_03v3 L=0.28u W=0.50u nf=1
XM15 Q Q_bar vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM16 Q Q_bar vss vss nfet_03v3 L=0.28u W=0.50u nf=1
XM17 S Q_bar vdd vdd pfet_03v3 L=2.0u W=0.42u nf=1
XM18 S Q_bar vss vss nfet_03v3 L=2.4u W=0.42u nf=1
XM19 D_int d vdd vdd pfet_03v3 L=0.28u W=1.0u nf=1
XM20 D_int d vss vss nfet_03v3 L=0.28u W=0.50u nf=1
.ends

.subckt shift_reg_8bit vdd vss Q0 Q1 Q2 Q3 Q4 Q5 Q6 Q7 done serial_in clk rst_n
x1 vdd vss clk serial_in Q0 net1 rst_n dff_cell
x2 vdd vss clk Q0 Q1 net2 rst_n dff_cell
x3 vdd vss clk Q1 Q2 net3 rst_n dff_cell
x4 vdd vss clk Q2 Q3 net4 rst_n dff_cell
x5 vdd vss clk Q3 Q4 net5 rst_n dff_cell
x6 vdd vss clk Q4 Q5 net6 rst_n dff_cell
x7 vdd vss clk Q5 Q6 net7 rst_n dff_cell
x8 vdd vss clk Q6 Q7 net8 rst_n dff_cell
x9 vdd vss clk Q7 done net9 rst_n dff_cell
.ends

.subckt bit_reg vdd vss clk_sample clk_latch comp_out dout rst_n
x1 vdd clk_sample net1 vss async_inverter
x2 vdd clk_latch net2 vss async_inverter
x3 net1 net2 clk_gated vdd vss async_nand2
x4 vdd vss clk_gated comp_out dout q_bar rst_n dff_cell
.ends

