T {start} -125 6 0 0 0.2 0.2 {}
B 5 -2.5 -122.5 2.5 -117.5 {name=vdd dir=inout}
L 7 0 -120 0 -100 {}
T {vdd} 5 -115 0 0 0.2 0.2 {}
B 5 -2.5 117.5 2.5 122.5 {name=vss dir=inout}
L 7 0 100 0 120 {}
T {vss} 5 105 0 0 0.2 0.2 {}
B 5 147.5 -72.5 152.5 -67.5 {name=done dir=out}
L 4 130 -70 150 -70 {}
T {done} 125 -74 0 1 0.2 0.2 {}
B 5 147.5 -52.5 152.5 -47.5 {name=dout[7] dir=out}
L 4 130 -50 150 -50 {}
