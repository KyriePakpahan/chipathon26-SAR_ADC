L 4 130 -30 150 -30 {}
T {dout[6]} 125 -34 0 1 0.2 0.2 {}
B 5 147.5 -12.5 152.5 -7.5 {name=dout[5] dir=out}
L 4 130 -10 150 -10 {}
T {dout[5]} 125 -14 0 1 0.2 0.2 {}
B 5 147.5 7.5 152.5 12.5 {name=dout[4] dir=out}
L 4 130 10 150 10 {}
T {dout[4]} 125 6 0 1 0.2 0.2 {}
B 5 147.5 27.5 152.5 32.5 {name=dout[3] dir=out}
L 4 130 30 150 30 {}
